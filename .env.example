# ============================
# LoveAll - Variaveis de Ambiente
# ============================

# Ambiente: development | production
NODE_ENV=production

# Porta do servidor
PORT=3001

# Chave secreta JWT (OBRIGATORIO mudar em producao!)
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=MUDE_ESTA_CHAVE_EM_PRODUCAO

# Origens permitidas para CORS (separar por virgula)
CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com

# Caminho do banco de dados SQLite
DB_PATH=./data/loveall.db
