# Acrescentar os valores ao .env da Oracle somente depois de concluir os registros.
PLAY_BILLING_ENABLED=false
PLAY_PACKAGE_NAME=com.loveall.app
PLAY_AD_FREE_PRODUCT_IDS=
# Base64 de 32 bytes aleatórios; preservar junto aos backups, fora do repositório.
PLAY_TOKEN_ENCRYPTION_KEY=
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# A credencial é lida do arquivo .secrets/play-service-account.json, montado pelo Compose.
