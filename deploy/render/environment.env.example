# Preencha exclusivamente no painel Environment do Render; nunca no Android/Git.
# Escolha Free no Render e no Supabase. Não habilite upgrades automáticos.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
PHOTO_STORAGE=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=loveall-photos
TRUST_PROXY_HOPS=1
PLAY_BILLING_ENABLED=false
# JWT_SECRET é gerado pelo Blueprint. Preserve-o nos próximos deployments.
# Se o painel do Supabase fornecer uma CA própria, adicione o certificado como
# Secret File e use PG_CA_CERT_PATH=/etc/secrets/prod-ca.crt. Nunca desative TLS.

# Identificador publico da conta AdMob para /app-ads.txt.
ADMOB_PUBLISHER_ID=pub-7902597376494373
